+void BrawlerPadTouchControlsShow(void) {
+    const BrawlerPadTouch::Preferences preferences =
+        BrawlerPadTouch::ShowTouchControls({ sEnabled.load(), sHideForController.load() });
+    sEnabled.store(preferences.touchControls);
+    sHideForController.store(preferences.hideWithController);
+    SDL_Log("[BrawlerPad] touch controls shown; hide with controller turned off");
+    // Close the menu so the restored controls are usable at once; the menu
+    // button and the same player-1 input path stay as they were.
+    dispatch_async(dispatch_get_main_queue(),^{ InstallLifecycleObservers(); if (sMenuVisible.load()) QueueMenuToggle(); ApplyState(); });
