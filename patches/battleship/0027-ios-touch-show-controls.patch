 }
diff --git a/port/ios/brawlerpad_touch_visibility.h b/port/ios/brawlerpad_touch_visibility.h
new file mode 100644
index 0000000..98dcae1
--- /dev/null
+++ b/port/ios/brawlerpad_touch_visibility.h
@@ -0,0 +1,22 @@
+#pragma once
+
+// Touch-control visibility shared by the UIKit overlay, the settings menu and
+// BrawlerPad's host tests. Physical-controller detection stays in the overlay.
+namespace BrawlerPadTouch {
+
+struct Preferences {
+    bool touchControls = true;      // "Enable Touch Controls"
+    bool hideWithController = true; // "Hide Touch Controls With Controller"
+};
+
+// "Show Touch Controls" restores the controls and turns auto-hide off until
+// the player turns it back on.
+constexpr Preferences ShowTouchControls(Preferences) {
+    return { true, false };
+}
+
+constexpr bool GameplayControlsVisible(const Preferences& preferences, bool physicalControllerConnected) {
+    return preferences.touchControls && !(preferences.hideWithController && physicalControllerConnected);
+}
+
+} // namespace BrawlerPadTouch
