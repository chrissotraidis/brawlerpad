+void RemovePickerCopyIfTemporary(NSURL* sourceURL) {
+    if (sourceURL == nil || !sourceURL.isFileURL) {
+        return;
+    }
+
+    NSString* sourcePath = sourceURL.path.stringByStandardizingPath;
+    NSString* temporaryRoot = NSTemporaryDirectory().stringByStandardizingPath;
+    if (![temporaryRoot hasSuffix:@"/"]) {
+        temporaryRoot = [temporaryRoot stringByAppendingString:@"/"];
+    }
+    if (![sourcePath hasPrefix:temporaryRoot]) {
+        return;
+    }
+
+    NSError* cleanupError = nil;
+    if (![NSFileManager.defaultManager removeItemAtURL:sourceURL error:&cleanupError] &&
+        cleanupError.code != NSFileNoSuchFileError) {
+        NSLog(@"[BrawlerPad] could not remove Files picker copy at %@: %@",
+              sourcePath, cleanupError.localizedDescription);
+    }
+}
+
