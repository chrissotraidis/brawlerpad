+- (BOOL)isInStickZone:(CGPoint)point {
+    return point.x >= self.safeAreaInsets.left &&
+           point.x <= CGRectGetWidth(self.bounds) * .47 &&
+           point.y >= self.safeAreaInsets.top &&
+           point.y <= CGRectGetHeight(self.bounds) - self.safeAreaInsets.bottom;
+}
+- (void)touchesBegan:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+    if (self.layoutEditing || self.stickTouch != nil) return;
+    for (UITouch* touch in touches) {
+        CGPoint point = [touch locationInView:self];
+        if (![self isInStickZone:point]) continue;
+        self.stickTouch = touch;
+        self.stickTouchOrigin = point;
+        CGFloat half = MIN(CGRectGetWidth(self.stick.bounds), CGRectGetHeight(self.stick.bounds)) * .5;
+        UIEdgeInsets safe = self.safeAreaInsets;
+        CGFloat x = std::clamp(point.x, safe.left + half, CGRectGetWidth(self.bounds) * .47 - half);
+        CGFloat y = std::clamp(point.y, safe.top + half,
+                               CGRectGetHeight(self.bounds) - safe.bottom - half);
+        self.stick.center = CGPointMake(x, y);
+        self.stick.hidden = NO;
+        self.stick.alpha = sOpacity.load();
+        [self.stick beginInput];
+        break;
+    }
+}
+- (void)touchesMoved:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+    if (self.stickTouch == nil || ![touches containsObject:self.stickTouch]) return;
+    CGPoint point = [self.stickTouch locationInView:self];
+    CGPoint center = CGPointMake(CGRectGetMidX(self.stick.bounds), CGRectGetMidY(self.stick.bounds));
+    CGPoint delta = CGPointMake(point.x - self.stickTouchOrigin.x,
+                                point.y - self.stickTouchOrigin.y);
+    [self.stick updatePoint:CGPointMake(center.x + delta.x, center.y + delta.y)];
+}
+- (void)finishStickTouch:(BOOL)cancelled {
+    if (self.stickTouch == nil) return;
+    self.stickTouch = nil;
+    if (cancelled) [self.stick cancelInput]; else [self.stick finishInput];
+    self.stick.hidden = YES;
+}
+- (void)touchesEnded:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+    if (self.stickTouch != nil && [touches containsObject:self.stickTouch]) [self finishStickTouch:NO];
+}
+- (void)touchesCancelled:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+    if (self.stickTouch != nil && [touches containsObject:self.stickTouch]) [self finishStickTouch:YES];
+}
