+#if defined(__IOS__)
+static bool PortIsN64RomFile(const std::filesystem::path& path) {
+	std::ifstream input(path, std::ios::binary);
+	std::array<unsigned char, 4> magic = {};
+	input.read(reinterpret_cast<char*>(magic.data()), magic.size());
+	return input.gcount() == static_cast<std::streamsize>(magic.size()) &&
+	       (magic == std::array<unsigned char, 4>{ 0x80, 0x37, 0x12, 0x40 } ||
+	        magic == std::array<unsigned char, 4>{ 0x40, 0x12, 0x37, 0x80 } ||
+	        magic == std::array<unsigned char, 4>{ 0x37, 0x80, 0x40, 0x12 });
+}
+
+static void PortRecoverMisplacedIOSRom() {
+	const char* home = std::getenv("HOME");
+	if (home == nullptr || std::strcmp(SSB64_APP_NAME, "BrawlerPad") != 0) {
+		return;
+	}
+
+	namespace fs = std::filesystem;
+	const fs::path support = fs::path(home) / "Library" / "Application Support";
+	const fs::path appData = support / "BrawlerPad";
+	const fs::path stagedRom = support / "BrawlerPad-ROM-Recovery.n64";
+	const fs::path stagedConfig = support / "BrawlerPad-restored.cfg.json";
+	std::error_code ec;
+
+	bool resume = fs::is_regular_file(stagedRom, ec) && PortIsN64RomFile(stagedRom);
+	ec.clear();
+	if (fs::is_regular_file(appData, ec)) {
+		if (!PortIsN64RomFile(appData) || resume) {
+			return;
+		}
+		fs::rename(appData, stagedRom, ec);
+		if (ec) {
+			port_log("BrawlerPad: could not stage misplaced ROM: %s\n", ec.message().c_str());
+			return;
+		}
+		resume = true;
+	}
+	if (!resume || fs::exists(appData, ec)) {
+		return;
+	}
+
+	ec.clear();
+	fs::create_directory(appData, ec);
+	if (!ec) {
+		fs::rename(stagedRom, appData / "baserom.us.n64", ec);
+	}
+	if (ec) {
+		const std::string error = ec.message();
+		std::error_code rollbackError;
+		fs::remove(appData, rollbackError);
+		fs::rename(stagedRom, appData, rollbackError);
+		port_log("BrawlerPad: misplaced ROM recovery failed: %s\n", error.c_str());
+		return;
+	}
+
+	ec.clear();
+	if (fs::is_regular_file(stagedConfig, ec) &&
+	    !fs::exists(appData / "BrawlerPad.cfg.json", ec)) {
+		fs::rename(stagedConfig, appData / "BrawlerPad.cfg.json", ec);
+	}
+	port_log("BrawlerPad: recovered misplaced ROM into Application Support/BrawlerPad\n");
+}
+#endif
+
