+extern "C" {
+int BrawlerPadTouchControlsAvailable(void) { return 1; }
+void BrawlerPadTouchControlsInitialize(void) { AttachVirtualController(); }
+int BrawlerPadTouchControlsGetControllerInstanceId(void) { return static_cast<int>(sTouchInstanceId); }
+void BrawlerPadTouchControlsSetEnabled(int enabled) {
+    sEnabled.store(enabled!=0); SDL_Log("[BrawlerPad] set touch enabled=%d", enabled!=0);
+    dispatch_async(dispatch_get_main_queue(),^{ InstallLifecycleObservers(); ApplyState(); });
+}
+void BrawlerPadTouchControlsSetHideWhenControllerConnected(int enabled) {
+    sHideForController.store(enabled!=0); dispatch_async(dispatch_get_main_queue(),^{ ApplyState(); });
+}
+void BrawlerPadTouchControlsSetOpacity(float opacity) {
+    sOpacity.store(std::clamp(opacity,.25f,1.0f)); dispatch_async(dispatch_get_main_queue(),^{ ApplyState(); });
+}
+void BrawlerPadTouchControlsBeginEditing(void) {
+    dispatch_async(dispatch_get_main_queue(),^{ sEditorRequested=YES; if (sMenuVisible.load()) QueueMenuToggle(); else ApplyState(); });
+}
+void BrawlerPadTouchControlsFrameUpdate(int menuVisible) {
+    bool physical=HasPhysicalController(); bool oldPhysical=sPhysicalControllerConnected.exchange(physical); bool visible=menuVisible!=0; bool oldMenu=sMenuVisible.exchange(visible);
+    if (physical!=oldPhysical) {
+        SDL_Log("[BrawlerPad] physical controller state changed to %d; %d SDL joysticks", physical, SDL_NumJoysticks());
+        for (int i=0;i<SDL_NumJoysticks();++i) {
+            SDL_Log("[BrawlerPad] joystick %d name='%s' instance=%d virtual=%d gamecontroller=%d",
+                    i, SDL_JoystickNameForIndex(i) ?: "(unnamed)",
+                    static_cast<int>(SDL_JoystickGetDeviceInstanceID(i)),
+                    SDL_JoystickIsVirtual(i), SDL_IsGameController(i));
+        }
+    }
+    if (physical!=oldPhysical || visible!=oldMenu) dispatch_async(dispatch_get_main_queue(),^{ ApplyState(); });
+}
+int BrawlerPadTouchControlsDrainMenuToggle(void) { return sMenuTogglePending.exchange(false)?1:0; }
+void BrawlerPadTouchControlsShutdown(void) {
+    void (^cleanup)(void)=^{ [sOverlay cancelAllInputs]; [sOverlay removeFromSuperview]; sOverlay=nil; [sMenuButton removeFromSuperview]; sMenuButton=nil; };
+    if (NSThread.isMainThread) cleanup(); else dispatch_sync(dispatch_get_main_queue(),cleanup);
+    std::lock_guard<std::mutex> lock(sJoystickMutex);
+    if (sJoystick) { SDL_JoystickClose(sJoystick); sJoystick=nullptr; }
+    sTouchInstanceId=-1;
+    if (sDeviceIndex>=0) { SDL_JoystickDetachVirtual(sDeviceIndex); sDeviceIndex=-1; }
+    sCUp=sCDown=sCLeft=sCRight=false;
+}
