+
+UIWindow* ActiveWindow() {
+    for (UIScene* scene in UIApplication.sharedApplication.connectedScenes) {
+        if (![scene isKindOfClass:UIWindowScene.class]) continue;
+        for (UIWindow* window in ((UIWindowScene*)scene).windows) if (window.isKeyWindow) return window;
+    }
+    return nil;
+}
+
+void QueueMenuToggle() { sMenuTogglePending.store(true); }
+
+void InstallMenuButton(UIWindow* window) {
+    if (!sMenuButton) {
+        sMenuButton=[UIButton buttonWithType:UIButtonTypeSystem]; [sMenuButton setTitle:@"•••" forState:UIControlStateNormal];
+        [sMenuButton setTitleColor:UIColor.whiteColor forState:UIControlStateNormal]; sMenuButton.backgroundColor=[UIColor colorWithWhite:.03 alpha:.62];
+        sMenuButton.layer.borderColor=[UIColor colorWithWhite:1 alpha:.58].CGColor; sMenuButton.layer.borderWidth=1.5; sMenuButton.accessibilityLabel=@"BrawlerPad menu";
+        [sMenuButton addTarget:UIApplication.sharedApplication action:@selector(brawlerPadToggleMenu) forControlEvents:UIControlEventTouchUpInside];
+    }
+    CGFloat size=44, w=CGRectGetWidth(window.bounds); UIEdgeInsets safe=window.safeAreaInsets;
+    sMenuButton.frame=CGRectMake(w-safe.right-size-8,safe.top+8,size,size); sMenuButton.layer.cornerRadius=size/2; sMenuButton.alpha=sOpacity.load();
+    if (sMenuButton.superview!=window) { [sMenuButton removeFromSuperview]; [window addSubview:sMenuButton]; }
+    [window bringSubviewToFront:sMenuButton];
+}
+
+@implementation UIApplication (BrawlerPadTouchMenu)
+- (void)brawlerPadToggleMenu { QueueMenuToggle(); }
+@end
+
+void InstallLifecycleObservers() {
+    if (sLifecycleObserversInstalled) return; sLifecycleObserversInstalled=YES;
+    for (NSNotificationName name in @[UIApplicationWillResignActiveNotification,UIApplicationDidEnterBackgroundNotification]) {
+        [NSNotificationCenter.defaultCenter addObserverForName:name object:nil queue:NSOperationQueue.mainQueue usingBlock:^(NSNotification* note){ (void)note; [sOverlay cancelAllInputs]; }];
+    }
+}
+
+void ApplyState() {
+    UIWindow* window=ActiveWindow();
+    if (!window) { dispatch_after(dispatch_time(DISPATCH_TIME_NOW,NSEC_PER_MSEC*200),dispatch_get_main_queue(),^{ ApplyState(); }); return; }
+    InstallMenuButton(window);
+    BOOL gameplayVisible=sEnabled.load() && !sMenuVisible.load() && !(sHideForController.load() && sPhysicalControllerConnected.load());
+    SDL_Log("[BrawlerPad] touch state enabled=%d menu=%d hideWithController=%d physical=%d gameplay=%d editor=%d",
+            sEnabled.load(), sMenuVisible.load(), sHideForController.load(),
+            sPhysicalControllerConnected.load(), gameplayVisible, sEditorRequested);
+    if (!gameplayVisible && !sEditorRequested) {
+        [sOverlay cancelAllInputs]; [sOverlay removeFromSuperview]; sOverlay=nil; return;
+    }
+    if (!sOverlay) { sOverlay=[[BrawlerPadTouchOverlay alloc] initWithFrame:window.bounds]; sOverlay.autoresizingMask=UIViewAutoresizingFlexibleWidth|UIViewAutoresizingFlexibleHeight; }
+    if (sOverlay.superview!=window) { sOverlay.frame=window.bounds; [window addSubview:sOverlay]; }
+    if (sEditorRequested && !sMenuVisible.load()) { sEditorRequested=NO; [sOverlay beginEditing]; }
+    [sOverlay setNeedsLayout]; [window bringSubviewToFront:sOverlay]; if (!sOverlay.layoutEditing) [window bringSubviewToFront:sMenuButton];
+}
+
+bool HasPhysicalController() {
+    for (int i=0;i<SDL_NumJoysticks();++i) {
+        if (SDL_JoystickGetDeviceInstanceID(i) == sTouchInstanceId) continue;
+        if (!SDL_JoystickIsVirtual(i) && SDL_IsGameController(i)) return true;
+    }
+    return false;
+}
