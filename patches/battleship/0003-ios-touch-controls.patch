+#if defined(__IOS__)
+
+#import <UIKit/UIKit.h>
+
+#include "brawlerpad_touch_controls.h"
+
+#include <SDL2/SDL.h>
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <mutex>
+
+namespace {
+
+SDL_Joystick* sJoystick = nullptr;
+int sDeviceIndex = -1;
+SDL_JoystickID sTouchInstanceId = -1;
+std::mutex sJoystickMutex;
+std::atomic_bool sEnabled{true};
+std::atomic_bool sHideForController{true};
+std::atomic_bool sPhysicalControllerConnected{false};
+std::atomic_bool sMenuVisible{false};
+std::atomic_bool sMenuTogglePending{false};
+std::atomic<float> sOpacity{0.70f};
+BOOL sEditorRequested = NO;
+BOOL sLifecycleObserversInstalled = NO;
+
+bool sCUp = false;
+bool sCDown = false;
+bool sCLeft = false;
+bool sCRight = false;
+
+bool AttachVirtualController() {
+    std::lock_guard<std::mutex> lock(sJoystickMutex);
+    if (sJoystick != nullptr) {
+        return true;
+    }
+
+    SDL_VirtualJoystickDesc desc;
+    SDL_zero(desc);
+    desc.version = SDL_VIRTUAL_JOYSTICK_DESC_VERSION;
+    desc.type = SDL_JOYSTICK_TYPE_GAMECONTROLLER;
+    desc.naxes = SDL_CONTROLLER_AXIS_MAX;
+    desc.nbuttons = SDL_CONTROLLER_BUTTON_MAX;
+    desc.vendor_id = 0x045E;
+    desc.product_id = 0x028E;
+    desc.name = "BrawlerPad Touch Controller";
+    sDeviceIndex = SDL_JoystickAttachVirtualEx(&desc);
+    if (sDeviceIndex < 0) {
+        SDL_Log("[BrawlerPad] virtual touch controller attach failed: %s", SDL_GetError());
+        return false;
+    }
+    sJoystick = SDL_JoystickOpen(sDeviceIndex);
+    if (sJoystick == nullptr) {
+        SDL_Log("[BrawlerPad] virtual touch controller open failed: %s", SDL_GetError());
+        SDL_JoystickDetachVirtual(sDeviceIndex);
+        sDeviceIndex = -1;
+        return false;
+    }
+    sTouchInstanceId = SDL_JoystickInstanceID(sJoystick);
+    // SDL's Xbox mapping expects raw triggers to rest at -32768. Virtual
+    // axes otherwise start at zero, which reads as a half-pressed Z and R.
+    SDL_JoystickSetVirtualAxis(sJoystick, SDL_CONTROLLER_AXIS_TRIGGERLEFT, -32768);
+    SDL_JoystickSetVirtualAxis(sJoystick, SDL_CONTROLLER_AXIS_TRIGGERRIGHT, -32768);
+    SDL_Log("[BrawlerPad] touch controller attached as SDL joystick %d (instance %d)",
+            sDeviceIndex, static_cast<int>(sTouchInstanceId));
+    return true;
+}
+
+void SetButton(int button, bool down) {
+    std::lock_guard<std::mutex> lock(sJoystickMutex);
+    if (sJoystick != nullptr && button >= 0 && button < SDL_CONTROLLER_BUTTON_MAX) {
+        SDL_JoystickSetVirtualButton(sJoystick, button, down ? 1 : 0);
+    }
+}
+
+void SetAxis(int axis, int value) {
+    std::lock_guard<std::mutex> lock(sJoystickMutex);
+    if (sJoystick != nullptr && axis >= 0 && axis < SDL_CONTROLLER_AXIS_MAX) {
+        SDL_JoystickSetVirtualAxis(sJoystick, axis,
+                                   static_cast<Sint16>(std::clamp(value, -32768, 32767)));
+    }
+}
+
+void SetCDirection(int direction, bool down) {
+    switch (direction) {
+        case 0: sCUp = down; break;
+        case 1: sCDown = down; break;
+        case 2: sCLeft = down; break;
+        case 3: sCRight = down; break;
+        default: return;
+    }
+    const int x = (sCRight ? 32767 : 0) + (sCLeft ? -32768 : 0);
+    const int y = (sCDown ? 32767 : 0) + (sCUp ? -32768 : 0);
+    SetAxis(SDL_CONTROLLER_AXIS_RIGHTX, x);
+    SetAxis(SDL_CONTROLLER_AXIS_RIGHTY, y);
+}
+
+} // namespace
+
+typedef NS_ENUM(NSInteger, BPInputKind) {
+    BPInputButton,
+    BPInputTrigger,
+    BPInputCDirection,
+};
+
+@interface BrawlerPadTouchButton : UIButton
+@property(nonatomic) BPInputKind inputKind;
+@property(nonatomic) int inputCode;
+@property(nonatomic) BOOL inputPressed;
+@property(nonatomic) BOOL layoutEditing;
+@property(nonatomic) BOOL pill;
+@property(nonatomic, strong) UIColor* idleColor;
+@property(nonatomic, strong) UIColor* pressedColor;
+- (instancetype)initWithLabel:(NSString*)label kind:(BPInputKind)kind code:(int)code pill:(BOOL)pill;
+- (void)setPressed:(BOOL)pressed;
+- (void)cancelInput;
+@end
+
+@implementation BrawlerPadTouchButton
+- (instancetype)initWithLabel:(NSString*)label kind:(BPInputKind)kind code:(int)code pill:(BOOL)pill {
+    self = [super initWithFrame:CGRectZero];
+    if (self) {
+        self.inputKind = kind;
+        self.inputCode = code;
+        self.pill = pill;
+        self.multipleTouchEnabled = YES;
+        self.idleColor = [UIColor colorWithWhite:0.04 alpha:0.54];
+        self.pressedColor = [UIColor colorWithWhite:0.78 alpha:0.78];
+        self.backgroundColor = self.idleColor;
+        self.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.72].CGColor;
+        self.layer.borderWidth = 2.0;
+        [self setTitle:label forState:UIControlStateNormal];
+        [self setTitleColor:UIColor.whiteColor forState:UIControlStateNormal];
+        self.titleLabel.font = [UIFont systemFontOfSize:17.0 weight:UIFontWeightBold];
+        self.accessibilityLabel = label;
+        [self addTarget:self action:@selector(inputDown) forControlEvents:UIControlEventTouchDown | UIControlEventTouchDragEnter];
+        [self addTarget:self action:@selector(inputUp) forControlEvents:UIControlEventTouchUpInside | UIControlEventTouchUpOutside | UIControlEventTouchCancel | UIControlEventTouchDragExit];
+    }
+    return self;
+}
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    self.layer.cornerRadius = self.pill ? CGRectGetHeight(self.bounds) * 0.48
+                                        : MIN(CGRectGetWidth(self.bounds), CGRectGetHeight(self.bounds)) * 0.5;
+}
+- (void)setPressed:(BOOL)pressed {
+    if (self.inputPressed == pressed || self.layoutEditing) return;
+    self.inputPressed = pressed;
+    self.backgroundColor = pressed ? self.pressedColor : self.idleColor;
+    switch (self.inputKind) {
+        case BPInputButton: SetButton(self.inputCode, pressed); break;
+        case BPInputTrigger: SetAxis(self.inputCode, pressed ? 32767 : -32768); break;
+        case BPInputCDirection: SetCDirection(self.inputCode, pressed); break;
+    }
+}
+- (void)inputDown { [self setPressed:YES]; }
+- (void)inputUp { [self setPressed:NO]; }
+- (void)cancelInput {
+    BOOL editing = self.layoutEditing;
+    self.layoutEditing = NO;
+    [self setPressed:NO];
+    self.layoutEditing = editing;
+}
+@end
+
+@interface BrawlerPadTouchStick : UIView
+@property(nonatomic, strong) UIView* knob;
+@property(nonatomic) BOOL layoutEditing;
+@property(nonatomic) BOOL inputTracking;
+- (BOOL)tracking;
+- (void)updatePoint:(CGPoint)point;
+- (void)cancelInput;
+@end
+
+@implementation BrawlerPadTouchStick
+- (instancetype)initWithFrame:(CGRect)frame {
+    self = [super initWithFrame:frame];
+    if (self) {
+        self.backgroundColor = [UIColor colorWithWhite:0.04 alpha:0.45];
+        self.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.58].CGColor;
+        self.layer.borderWidth = 2.0;
+        self.accessibilityLabel = @"Analog Stick";
+        self.isAccessibilityElement = YES;
+        self.knob = [[UIView alloc] initWithFrame:CGRectZero];
+        self.knob.userInteractionEnabled = NO;
+        self.knob.backgroundColor = [UIColor colorWithRed:0.30 green:0.62 blue:0.94 alpha:0.80];
+        self.knob.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.72].CGColor;
+        self.knob.layer.borderWidth = 2.0;
+        [self addSubview:self.knob];
+    }
+    return self;
+}
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    CGFloat side = MIN(CGRectGetWidth(self.bounds), CGRectGetHeight(self.bounds));
+    self.layer.cornerRadius = side * 0.5;
+    self.knob.bounds = CGRectMake(0, 0, side * 0.42, side * 0.42);
+    self.knob.layer.cornerRadius = side * 0.21;
+    if (![self tracking]) self.knob.center = CGPointMake(CGRectGetMidX(self.bounds), CGRectGetMidY(self.bounds));
+}
+- (BOOL)tracking { return self.inputTracking; }
+- (void)updatePoint:(CGPoint)point {
+    if (self.layoutEditing) return;
+    CGPoint center = CGPointMake(CGRectGetMidX(self.bounds), CGRectGetMidY(self.bounds));
+    CGFloat radius = MIN(CGRectGetWidth(self.bounds), CGRectGetHeight(self.bounds)) * 0.34;
+    CGFloat dx = point.x - center.x;
+    CGFloat dy = point.y - center.y;
+    CGFloat distance = hypot(dx, dy);
+    if (distance > radius && distance > 0) { dx *= radius / distance; dy *= radius / distance; distance = radius; }
+    self.knob.center = CGPointMake(center.x + dx, center.y + dy);
+
+    // Circular deadzone with the remaining travel remapped to the full SDL
+    // range. This preserves continuous angles and full diagonal magnitude.
+    CGFloat magnitude = radius > 0 ? distance / radius : 0;
+    const CGFloat deadzone = 0.12;
+    CGFloat output = magnitude <= deadzone ? 0 : (magnitude - deadzone) / (1.0 - deadzone);
+    CGFloat nx = distance > 0 ? dx / distance * output : 0;
+    CGFloat ny = distance > 0 ? dy / distance * output : 0;
+    SetAxis(SDL_CONTROLLER_AXIS_LEFTX, static_cast<int>(lround(nx * 32767.0)));
+    SetAxis(SDL_CONTROLLER_AXIS_LEFTY, static_cast<int>(lround(ny * 32767.0)));
+}
+- (void)touchesBegan:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event { self.inputTracking=YES; [self updatePoint:[touches.anyObject locationInView:self]]; }
+- (void)touchesMoved:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event { [self updatePoint:[touches.anyObject locationInView:self]]; }
+- (void)touchesEnded:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event { [self cancelInput]; }
+- (void)touchesCancelled:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event { [self cancelInput]; }
+- (void)cancelInput {
+    SetAxis(SDL_CONTROLLER_AXIS_LEFTX, 0);
+    SetAxis(SDL_CONTROLLER_AXIS_LEFTY, 0);
+    self.inputTracking=NO;
+    self.knob.center = CGPointMake(CGRectGetMidX(self.bounds), CGRectGetMidY(self.bounds));
+}
+@end
+
