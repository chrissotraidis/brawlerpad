+
+// Poll the asynchronous picker result.
+//   0 = waiting/idle, 1 = selected (path populated), 2 = cancelled,
+//  -1 = error (error populated). A terminal result is consumed by this call.
+int BrawlerPadIOSPollRomPicker(char* path, size_t pathCapacity,
+                               char* error, size_t errorCapacity);
