+#!/bin/sh
+set -eu
+
+source_root=$1
+region=$2
+bundle_dir=${TARGET_BUILD_DIR:?Xcode did not provide TARGET_BUILD_DIR}/${WRAPPER_NAME:?Xcode did not provide WRAPPER_NAME}
+
+mkdir -p "$bundle_dir/assets/custom/fonts" "$bundle_dir/yamls/$region"
+
+cp -f "$source_root/f3d.o2r" "$bundle_dir/f3d.o2r"
+cp -f "$source_root/gamecontrollerdb.txt" "$bundle_dir/gamecontrollerdb.txt"
+cp -f "$source_root/config.yml" "$bundle_dir/config.yml"
+cp -f "$source_root/assets/custom/fonts/Montserrat-Regular.ttf" "$bundle_dir/assets/custom/fonts/Montserrat-Regular.ttf"
+cp -f "$source_root/assets/custom/fonts/Inconsolata-Regular.ttf" "$bundle_dir/assets/custom/fonts/Inconsolata-Regular.ttf"
+cp -f "$source_root/yamls/$region/"*.yml "$bundle_dir/yamls/$region/"
