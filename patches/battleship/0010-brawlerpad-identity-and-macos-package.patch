diff --git a/CMakeLists.txt b/CMakeLists.txt
index 77613fe..34c5740 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2,6 +2,8 @@ cmake_minimum_required(VERSION 3.24.0 FATAL_ERROR)
 
 project(ssb64 LANGUAGES C CXX)
 
+option(BRAWLERPAD_BRANDING "Use BrawlerPad application identity" OFF)
+
 set(SSB64_MOBILE OFF)
 if (CMAKE_SYSTEM_NAME STREQUAL "Android" OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
     set(SSB64_MOBILE ON)
@@ -15,7 +17,9 @@ if (CMAKE_SYSTEM_NAME STREQUAL "iOS")
         "Minimum supported iOS/iPadOS version" FORCE)
     set(DEPLOYMENT_TARGET "17.0" CACHE STRING
         "Minimum supported iOS/iPadOS version" FORCE)
+endif()
 
+if (BRAWLERPAD_BRANDING)
     # Release binaries must not disclose a maintainer's checkout or build
     # directory. Apply this at the directory level before any project or
     # fetched-dependency targets are created so __FILE__ is stable too.
@@ -245,6 +249,12 @@ if (SSB64_MOBILE)
 else()
     # Desktop: build Torch as a host executable via ExternalProject so it
     # can run at our build time to extract ROM assets.
+    set(SSB64_TORCH_REPRO_ARGS)
+    if(BRAWLERPAD_BRANDING)
+        list(APPEND SSB64_TORCH_REPRO_ARGS
+            "-DCMAKE_C_FLAGS=-ffile-prefix-map=${CMAKE_SOURCE_DIR}=BattleShip -ffile-prefix-map=${CMAKE_BINARY_DIR}=BrawlerPadBuild"
+            "-DCMAKE_CXX_FLAGS=-ffile-prefix-map=${CMAKE_SOURCE_DIR}=BattleShip -ffile-prefix-map=${CMAKE_BINARY_DIR}=BrawlerPadBuild")
+    endif()
     ExternalProject_Add(TorchExternal
         PREFIX TorchExternal
         SOURCE_DIR ${CMAKE_SOURCE_DIR}/torch
@@ -260,6 +270,7 @@ else()
             -DBUILD_MARIO_ARTIST=OFF
             -DBUILD_NAUDIO=ON
             -DBUILD_SSB64=ON
+            ${SSB64_TORCH_REPRO_ARGS}
     )
 
     ExternalProject_Get_Property(TorchExternal install_dir)
@@ -583,7 +594,9 @@ endif()
 # updater / release links are unaffected. This single value drives the
 # binary OUTPUT_NAME, the libultraship Context name/shortName (which scopes
 # the app-data directory), and the per-platform package scripts.
-if(SSB64_VERSION STREQUAL "jp")
+if(BRAWLERPAD_BRANDING)
+    set(SSB64_APP_NAME "BrawlerPad")
+elseif(SSB64_VERSION STREQUAL "jp")
     set(SSB64_APP_NAME "BattleShip-JP")
 else()
     set(SSB64_APP_NAME "BattleShip")
