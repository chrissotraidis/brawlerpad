+constexpr bool UseTabletUIScale(int width, int height) {
+    const int shortestSide = width < height ? width : height;
+    const int longestSide = width > height ? width : height;
+    const float aspectRatio = shortestSide > 0 ? static_cast<float>(longestSide) / shortestSide : 0.0f;
+    return shortestSide >= 600 && aspectRatio < 1.6f;
+}
+
+static_assert(!UseTabletUIScale(2532, 1170));
+static_assert(!UseTabletUIScale(844, 390));
+static_assert(UseTabletUIScale(2732, 2048));
+static_assert(UseTabletUIScale(1366, 1024));
+#endif
