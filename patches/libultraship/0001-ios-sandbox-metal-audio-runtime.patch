diff --git a/src/ship/Context.cpp b/src/ship/Context.cpp
index 34b37a64..cf01f00f 100644
--- a/src/ship/Context.cpp
+++ b/src/ship/Context.cpp
@@ -454,8 +454,11 @@ std::string Context::GetAppBundlePath() {
 #endif
 
 #ifdef __IOS__
-    const char* home = getenv("HOME");
-    return std::string(home) + "/Documents";
+    // Immutable resources live in the signed application bundle. Returning
+    // Documents here made iOS look for f3d.o2r/config.yml beside user files
+    // and prevented a ROM-free .app from finding its own packaged data.
+    FolderManager iosFolderManager;
+    return iosFolderManager.getMainBundlePath();
 #endif
 
 #ifdef __APPLE__
@@ -523,8 +526,21 @@ std::string Context::GetAppDirectoryPath(std::string appName) {
 #endif
 
 #ifdef __IOS__
+    // Saves, configuration, logs, and the user-derived BattleShip.o2r belong
+    // in Library/Application Support, not the Files-visible Documents root.
+    // SDL_GetPrefPath creates the directory and matches main()'s early log
+    // path before Context exists.
+    if (appName.empty()) {
+        appName = GetInstance()->mShortName;
+    }
+    char* prefpath = SDL_GetPrefPath(NULL, appName.c_str());
+    if (prefpath != NULL) {
+        std::string ret(prefpath);
+        SDL_free(prefpath);
+        return ret;
+    }
     const char* home = getenv("HOME");
-    return std::string(home) + "/Documents";
+    return std::string(home ? home : "") + "/Library/Application Support/" + appName;
 #endif
 
 #if defined(__APPLE__)
