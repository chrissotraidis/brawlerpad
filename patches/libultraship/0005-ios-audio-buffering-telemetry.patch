@@ -22,5 +22,12 @@ class SDLAudioPlayer final : public AudioPlayer {
     SDL_AudioDeviceID mDevice = 0;
     int32_t mNumChannels = 2;
     std::atomic<bool> mPaused = false;
+#ifdef __IOS__
+    bool mPriming = true;
+    uint32_t mTelemetryFrames = 0;
+    uint32_t mUnderruns = 0;
