     }
 }
+
+static void RetryIOSAudioInitialization() {
+    static Uint32 nextRetryAt = 0;
+    auto context = Ship::Context::GetInstance();
+    if (!context || !context->GetAudio()) {
+        return;
+    }
+
+    Uint32 now = SDL_GetTicks();
+    if (static_cast<Sint32>(now - nextRetryAt) < 0) {
+        return;
+    }
+    if (!context->GetAudio()->RetryInitialization()) {
+        nextRetryAt = now + 500;
+    }
+}
 #endif
 
